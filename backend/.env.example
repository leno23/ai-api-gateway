APP_ENV=development
HTTP_ADDR=:8080

DATABASE_DSN=host=localhost user=gateway password=gateway dbname=ai_gateway port=5432 sslmode=disable TimeZone=UTC
REDIS_ADDR=localhost:6379

JWT_SECRET=change-me-in-production-min-32-chars-long!!

# Upstream OpenAI-compatible (e.g. OpenAI or DeepSeek OpenAI-compatible base)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# Redis fixed-window limits for /v1 (0 disables that tier)
RATE_LIMIT_GLOBAL_PER_MIN=200000
RATE_LIMIT_USER_PER_MIN=120

# Periodically align Redis quota:user:* from Postgres (seconds, 0 = off)
QUOTA_RECONCILE_INTERVAL_SEC=120

# Optional consume rebate: apply migrations/002_rebate_tasks.sql when enabling
# REBATE_ENABLED=false
# REBATE_BPS=0
# REBATE_POLL_SEC=10
